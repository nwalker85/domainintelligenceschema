@prefix dis: <https://schemas.domainintelligenceschema.org/dis/1.8.0/> .
@prefix b:   <https://dossier.ravenhelm.dev/bfsi/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://dossier.ravenhelm.dev/bfsi/> a owl:Ontology ;
    owl:versionInfo "1.8.0" ;
    dis:dossierType dis:DESIGN ;
    dis:dossierStatus dis:APPROVED ;
    rdfs:label "Banking, Financial Services & Insurance (BFSI) Multi-Domain Dossier" ;
    rdfs:comment "Dual-domain reference architecture: Retail Banking (authenticated accountholders vs unauthenticated callers across FIS and Fiserv) and Insurance Claims (FNOL, coverage, claim adjudication across Guidewire ClaimCenter & PolicyCenter)." .

# =============================================================================
# 1. SYSTEMS LAYER (FIS, Fiserv, Guidewire)
# =============================================================================

b:fis-modern-banking a dis:Application ;
    dis:name "FIS Modern Banking Platform (MBP)" ;
    dis:description "Real-time core banking engine for deposits, transaction ledgers, ACH transfers, and Reg E dispute intake." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://fis-core.bank.internal/api/v3" ;
    dis:authMethod dis:OAUTH2 .

b:fiserv-card-services a dis:Application ;
    dis:name "Fiserv Signature & Card Services" ;
    dis:description "Enterprise debit card processing, fraud monitoring, and instant debit card freeze gateway." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://cards.fiserv.bank.internal/v2" ;
    dis:authMethod dis:OAUTH2 .

b:guidewire-claimcenter a dis:Application ;
    dis:name "Guidewire ClaimCenter" ;
    dis:description "Property & casualty claims administration, First Notice of Loss (FNOL) intake, and adjuster adjudication engine." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://claimcenter.insurance.internal/rest/v1" ;
    dis:authMethod dis:OAUTH2 .

b:guidewire-policycenter a dis:Application ;
    dis:name "Guidewire PolicyCenter" ;
    dis:description "Underwriting and policy administration system holding personal auto, homeowners, and commercial coverage lines." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://policycenter.insurance.internal/rest/v1" ;
    dis:authMethod dis:OAUTH2 .

# --- Endpoints ---

b:ep-fis-get-balance a dis:Endpoint ;
    dis:name "FIS Get Account Balance" ;
    dis:description "Returns available and ledger balances for authenticated DDA accounts." ;
    dis:hostedBy b:fis-modern-banking ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:GET ;
    dis:urlPath "/accounts/{id}/balances" ;
    dis:mutates false .

b:ep-fis-create-transfer a dis:Endpoint ;
    dis:name "FIS Create Funds Transfer" ;
    dis:description "Executes internal account-to-account or external ACH transfer." ;
    dis:hostedBy b:fis-modern-banking ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/transfers" ;
    dis:mutates true .

b:ep-fis-create-dispute a dis:Endpoint ;
    dis:name "FIS Create Reg E Dispute" ;
    dis:description "Logs formal unauthorized charge dispute and initiates provisional credit review." ;
    dis:hostedBy b:fis-modern-banking ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/disputes" ;
    dis:mutates true .

b:ep-fiserv-freeze-card a dis:Endpoint ;
    dis:name "Fiserv Freeze Debit Card" ;
    dis:description "Toggles debit card status to FROZEN to prevent unauthorized POS and ATM debits." ;
    dis:hostedBy b:fiserv-card-services ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/cards/{id}/freeze" ;
    dis:mutates true .

b:ep-guidewire-submit-fnol a dis:Endpoint ;
    dis:name "Guidewire Submit FNOL" ;
    dis:description "Ingests First Notice of Loss incident data, assigns claim number, and routes to catastrophe/adjuster queue." ;
    dis:hostedBy b:guidewire-claimcenter ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/claims/fnol" ;
    dis:mutates true .

b:ep-guidewire-get-coverage a dis:Endpoint ;
    dis:name "Guidewire Get Policy Coverage" ;
    dis:description "Retrieves active coverages, deductibles, endorsements, and policy status." ;
    dis:hostedBy b:guidewire-policycenter ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:GET ;
    dis:urlPath "/policies/{id}/coverage" ;
    dis:mutates false .

b:ep-guidewire-get-claim a dis:Endpoint ;
    dis:name "Guidewire Get Claim Status" ;
    dis:description "Fetches claim adjudication progress, adjuster contact, and payment status." ;
    dis:hostedBy b:guidewire-claimcenter ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:GET ;
    dis:urlPath "/claims/{id}" ;
    dis:mutates false .

# --- Functions ---

b:fn-get-account-balance a dis:FunctionCatalogEntry ;
    dis:name "Get Account Balance" ;
    dis:description "Queries available balance in FIS MBP." ;
    dis:callsEndpoint b:ep-fis-get-balance ;
    dis:readsEntity b:demand-deposit-account ;
    dis:inputFields "account_id,auth_session_token" ;
    dis:outputFields "account_id,available_balance,ledger_balance,currency" .

b:fn-create-funds-transfer a dis:FunctionCatalogEntry ;
    dis:name "Create Funds Transfer" ;
    dis:description "Executes money transfer via FIS core." ;
    dis:callsEndpoint b:ep-fis-create-transfer ;
    dis:readsEntity b:demand-deposit-account ;
    dis:writesEntity b:account-transfer-record ;
    dis:inputFields "source_account_id,destination_account_id,amount,currency,transfer_type" ;
    dis:outputFields "transfer_id,status,settlement_date,confirmation_code" .

b:fn-dispute-transaction a dis:FunctionCatalogEntry ;
    dis:name "Dispute Charge" ;
    dis:description "Files Reg E dispute in FIS core." ;
    dis:callsEndpoint b:ep-fis-create-dispute ;
    dis:readsEntity b:demand-deposit-account ;
    dis:writesEntity b:transaction-dispute ;
    dis:inputFields "account_id,transaction_id,dispute_reason_code,disputed_amount" ;
    dis:outputFields "dispute_id,provisional_credit_eligibility,case_number,filing_date" .

b:fn-freeze-debit-card a dis:FunctionCatalogEntry ;
    dis:name "Freeze Lost Debit Card" ;
    dis:description "Applies instant freeze lock in Fiserv card services." ;
    dis:callsEndpoint b:ep-fiserv-freeze-card ;
    dis:readsEntity b:cardholder-debit-card ;
    dis:writesEntity b:cardholder-debit-card ;
    dis:inputFields "card_token,lock_reason,auth_token" ;
    dis:outputFields "card_token,card_status,lock_timestamp" .

b:fn-submit-fnol a dis:FunctionCatalogEntry ;
    dis:name "Submit FNOL Incident" ;
    dis:description "Submits claim FNOL to Guidewire ClaimCenter." ;
    dis:callsEndpoint b:ep-guidewire-submit-fnol ;
    dis:readsEntity b:insurance-policy-coverage ;
    dis:writesEntity b:first-notice-of-loss ;
    dis:inputFields "policy_number,date_of_loss,loss_location,incident_summary" ;
    dis:outputFields "claim_number,assigned_adjuster,initial_status,incident_id" .

b:fn-get-coverage a dis:FunctionCatalogEntry ;
    dis:name "Get Policy Coverage Info" ;
    dis:description "Retrieves coverage details from Guidewire PolicyCenter." ;
    dis:callsEndpoint b:ep-guidewire-get-coverage ;
    dis:readsEntity b:insurance-policy-coverage ;
    dis:inputFields "policy_number,effective_date" ;
    dis:outputFields "policy_number,comprehensive_deductible,collision_deductible,liability_limit" .

b:fn-get-claim-status a dis:FunctionCatalogEntry ;
    dis:name "Get Claim Adjudication Status" ;
    dis:description "Queries claim progress in Guidewire ClaimCenter." ;
    dis:callsEndpoint b:ep-guidewire-get-claim ;
    dis:readsEntity b:adjudicated-claim ;
    dis:inputFields "claim_number,policyholder_ssn_last4" ;
    dis:outputFields "claim_number,stage,adjuster_name,adjuster_phone,estimated_payout" .

# =============================================================================
# 2. ROLES & ENTITIES
# =============================================================================

# --- Roles (Authenticated vs Unauthenticated) ---

b:unauthenticated-caller a dis:Role ;
    dis:roleType "human" ;
    dis:name "Unauthenticated Caller" ;
    dis:description "Anonymous caller, prospective customer, or accountholder prior to step-up authentication. Structurally denied access to private banking entities." .

b:authenticated-accountholder a dis:Role ;
    dis:roleType "human" ;
    dis:name "Authenticated Accountholder" ;
    dis:description "Verified customer who has satisfied MFA / biometric security criteria and holds an active session token." .

b:insurance-claimant a dis:Role ;
    dis:roleType "human" ;
    dis:name "Insurance Claimant" ;
    dis:description "Policyholder, designated driver, or claimant reporting or tracking a casualty loss." .

b:bfsi-concierge-agent a dis:Role ;
    dis:roleType "agent" ;
    dis:name "BFSI Virtual Concierge" ;
    dis:description "Enterprise AI conversational agent assisting with banking operations and insurance claim intake." .

# --- Entities ---

b:demand-deposit-account a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Demand Deposit Account (DDA)" ;
    dis:description "Checking or savings ledger account held in FIS Modern Banking Platform." .

b:account-transfer-record a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Account Transfer Record" ;
    dis:description "Executed funds movement transaction." .

b:transaction-dispute a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Transaction Dispute Case" ;
    dis:description "Regulation E contested charge claim." .

b:cardholder-debit-card a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Cardholder Debit Card" ;
    dis:description "Debit card token and authorization state in Fiserv." .

b:public-branch-location a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Public Branch & ATM Location" ;
    dis:description "Public directory of physical branch hours, surcharge-free ATMs, and deposit drop-boxes." .

b:insurance-policy-coverage a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Insurance Policy Coverage" ;
    dis:description "P&C policy schedule in Guidewire PolicyCenter." .

b:first-notice-of-loss a dis:Entity ;
    dis:entityType "data" ;
    dis:name "First Notice of Loss (FNOL)" ;
    dis:description "Initial incident notification document submitted to Guidewire ClaimCenter." .

b:adjudicated-claim a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Adjudicated Insurance Claim" ;
    dis:description "Active claim file undergoing investigation, appraisal, or settlement." .

# =============================================================================
# 3. AGENTIC TRIPLETS
# =============================================================================

# Public / Unauthenticated
b:t1-lookup-branch-location a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity b:public-branch-location ;
    dis:bindingStatus dis:MANUAL_PROCEDURE ;
    dis:unboundReason "Lookup from public geospatial directory" ;
    dis:name "Lookup branch or ATM location" ;
    dis:description "Unauthenticated caller asks for nearest open branch or ATM." .

# Retail Banking (Authenticated Accountholder)
b:t2-lookup-balance a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-get-account-balance ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity b:demand-deposit-account ;
    dis:name "Lookup account balance" ;
    dis:description "Queries available balance in FIS core for verified customer." .

b:t3-execute-transfer a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-create-funds-transfer ;
    dis:stance dis:ACT ;
    dis:mode dis:CREATE ;
    dis:targetEntity b:account-transfer-record ;
    dis:name "Transfer funds" ;
    dis:description "Executes internal or external funds movement." .

b:t4-dispute-charge a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-dispute-transaction ;
    dis:stance dis:ACT ;
    dis:mode dis:CREATE ;
    dis:targetEntity b:transaction-dispute ;
    dis:name "Dispute unauthorized charge" ;
    dis:description "Initiates formal Reg E investigation in FIS." .

b:t5-freeze-lost-card a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-freeze-debit-card ;
    dis:stance dis:ACT ;
    dis:mode dis:UPDATE ;
    dis:targetEntity b:cardholder-debit-card ;
    dis:name "Freeze lost or stolen debit card" ;
    dis:description "Instantly freezes card in Fiserv." .

# Insurance Claims
b:t6-file-fnol a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-submit-fnol ;
    dis:stance dis:ACT ;
    dis:mode dis:CREATE ;
    dis:targetEntity b:first-notice-of-loss ;
    dis:name "Submit FNOL claim" ;
    dis:description "Files initial damage claim in Guidewire ClaimCenter." .

b:t7-check-policy-coverage a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-get-coverage ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity b:insurance-policy-coverage ;
    dis:name "Check policy coverage limits" ;
    dis:description "Queries policy deductibles and limits in Guidewire PolicyCenter." .

b:t8-track-claim-status a dis:AgenticTriplet ;
    dis:actingRole b:bfsi-concierge-agent ;
    dis:boundFunction b:fn-get-claim-status ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity b:adjudicated-claim ;
    dis:name "Track claim adjudication status" ;
    dis:description "Provides status and assigned adjuster details from Guidewire ClaimCenter." .

# =============================================================================
# 4. GOVERNANCE & UTTERANCE POLICIES
# =============================================================================

b:p1-pci-dss-card-redaction a dis:UtterancePolicy ;
    dis:name "PCI DSS full PAN redaction" ;
    dis:description "Mandatory compliance with Payment Card Industry Data Security Standard (PCI DSS) 4.0." ;
    dis:policyType dis:PROHIBITION ;
    dis:enforcement dis:STRUCTURAL ;
    dis:liabilityClass dis:REGULATORY ;
    dis:onViolation dis:REDACT ;
    dis:requirement "The agent must never speak, print, or log more than the last 4 digits of a payment card. CVV/CVC codes must be completely suppressed." ;
    dis:appliesToTriplet b:t5-freeze-lost-card ;
    dis:appliesToEntity b:cardholder-debit-card .

b:p2-glba-financial-privacy-limit a dis:UtterancePolicy ;
    dis:name "GLBA financial privacy disclosure limit" ;
    dis:description "Gramm-Leach-Bliley Act privacy mandate protecting customer non-public personal information." ;
    dis:policyType dis:DISCLOSURE_LIMIT ;
    dis:enforcement dis:STRUCTURAL ;
    dis:liabilityClass dis:FINANCIAL ;
    dis:onViolation dis:REFUSE ;
    dis:requirement "Account balances and transaction histories are disclosable only after successful cryptographic MFA authentication. Never disclosable to unauthenticated callers." ;
    dis:appliesToTriplet b:t2-lookup-balance ;
    dis:appliesToEntity b:demand-deposit-account .

b:p3-transfer-verbal-confirmation a dis:UtterancePolicy ;
    dis:name "Transfer verbal confirmation obligation" ;
    dis:description "Mandatory verbal readback before executing irreversible monetary debits." ;
    dis:policyType dis:OBLIGATION ;
    dis:enforcement dis:STRUCTURAL ;
    dis:liabilityClass dis:FINANCIAL ;
    dis:onViolation dis:REFUSE ;
    dis:requirement "Before committing a funds transfer, the agent MUST explicitly recite the source account, destination account, dollar amount, and fee schedule to the caller." ;
    dis:boundValue b:account-transfer-record ;
    dis:appliesToTriplet b:t3-execute-transfer ;
    dis:appliesToEntity b:account-transfer-record .

b:p4-fnol-emergency-redirection a dis:UtterancePolicy ;
    dis:name "FNOL bodily injury emergency deflection" ;
    dis:description "Directs active emergency casualty incidents to 911." ;
    dis:policyType dis:OBLIGATION ;
    dis:enforcement dis:STRUCTURAL ;
    dis:liabilityClass dis:SAFETY ;
    dis:onViolation dis:ESCALATE ;
    dis:requirement "If an FNOL report indicates active bodily injury, fire, or immediate highway hazard, the agent must instruct the caller to seek emergency medical attention before taking claim notes." ;
    dis:boundValue b:first-notice-of-loss ;
    dis:appliesToTriplet b:t6-file-fnol ;
    dis:appliesToEntity b:first-notice-of-loss .

# =============================================================================
# 5. GRAMMAR MATRICES (Denials are the Model)
# =============================================================================

b:emm-dda a dis:EntityModeMatrix ;
    dis:matrixEntity b:demand-deposit-account ;
    dis:supportedMode dis:READ ;
    dis:name "DDA supports READ" ;
    dis:description "Balance and account details are read-only in conversational interface." .

b:emm-transfer a dis:EntityModeMatrix ;
    dis:matrixEntity b:account-transfer-record ;
    dis:supportedMode dis:CREATE , dis:READ ;
    dis:name "Transfer supports CREATE, READ" ;
    dis:description "Transfers are created and queried; never edited." .

b:emm-dispute a dis:EntityModeMatrix ;
    dis:matrixEntity b:transaction-dispute ;
    dis:supportedMode dis:CREATE , dis:READ ;
    dis:name "Dispute supports CREATE, READ" ;
    dis:description "Disputes are submitted and tracked." .

b:emm-card a dis:EntityModeMatrix ;
    dis:matrixEntity b:cardholder-debit-card ;
    dis:supportedMode dis:READ , dis:UPDATE ;
    dis:name "Debit card supports READ, UPDATE" ;
    dis:description "Cards can be inspected or frozen (UPDATE)." .

b:emm-location a dis:EntityModeMatrix ;
    dis:matrixEntity b:public-branch-location ;
    dis:supportedMode dis:READ ;
    dis:name "Branch location supports READ" ;
    dis:description "Public location directory is read-only." .

b:emm-policy a dis:EntityModeMatrix ;
    dis:matrixEntity b:insurance-policy-coverage ;
    dis:supportedMode dis:READ ;
    dis:name "Policy coverage supports READ" ;
    dis:description "Coverage schedule is read-only." .

b:emm-fnol a dis:EntityModeMatrix ;
    dis:matrixEntity b:first-notice-of-loss ;
    dis:supportedMode dis:CREATE , dis:READ ;
    dis:name "FNOL supports CREATE, READ" ;
    dis:description "First notice of loss is immutable upon creation." .

b:emm-claim a dis:EntityModeMatrix ;
    dis:matrixEntity b:adjudicated-claim ;
    dis:supportedMode dis:READ ;
    dis:name "Claim adjudication supports READ" ;
    dis:description "Claim details are read-only." .

# --- Access Gates (Explicit Denials for Unauthenticated Callers) ---

# The Unauthenticated Gate: ONLY branch locations
b:gate-unauth-locations a dis:AccessGateMatrix ;
    dis:matrixRole b:unauthenticated-caller ;
    dis:matrixEntity b:public-branch-location ;
    dis:allowedMode dis:READ ;
    dis:name "Unauthenticated caller branch lookup gate" ;
    dis:description "Anonymous callers may only look up physical branches and ATMs. All core banking entities are denied." .

# The Authenticated Gates (All Banking Operations)
b:gate-auth-dda a dis:AccessGateMatrix ;
    dis:matrixRole b:authenticated-accountholder ;
    dis:matrixEntity b:demand-deposit-account ;
    dis:allowedMode dis:READ ;
    dis:name "Authenticated accountholder DDA gate" ;
    dis:description "Accountholder reads own balances." .

b:gate-auth-transfer a dis:AccessGateMatrix ;
    dis:matrixRole b:authenticated-accountholder ;
    dis:matrixEntity b:account-transfer-record ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Authenticated accountholder transfer gate" ;
    dis:description "Accountholder creates money transfers." .

b:gate-auth-dispute a dis:AccessGateMatrix ;
    dis:matrixRole b:authenticated-accountholder ;
    dis:matrixEntity b:transaction-dispute ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Authenticated accountholder dispute gate" ;
    dis:description "Accountholder files charge dispute." .

# Gate Scoping (G5): Card update is locked strictly to FREEZE
b:gate-auth-card a dis:AccessGateMatrix ;
    dis:matrixRole b:authenticated-accountholder ;
    dis:matrixEntity b:cardholder-debit-card ;
    dis:allowedMode dis:UPDATE ;
    dis:allowedFunction b:fn-freeze-debit-card ;
    dis:name "Authenticated card freeze gate (scoped)" ;
    dis:description "Accountholder may only freeze a card. Unfreezing or ordering replacement requires in-branch auth." .

# Insurance Gates
b:gate-claimant-coverage a dis:AccessGateMatrix ;
    dis:matrixRole b:insurance-claimant ;
    dis:matrixEntity b:insurance-policy-coverage ;
    dis:allowedMode dis:READ ;
    dis:name "Claimant policy coverage gate" ;
    dis:description "Claimant reads policy coverage limits." .

b:gate-claimant-fnol a dis:AccessGateMatrix ;
    dis:matrixRole b:insurance-claimant ;
    dis:matrixEntity b:first-notice-of-loss ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Claimant FNOL submission gate" ;
    dis:description "Claimant creates FNOL report." .

b:gate-claimant-claim a dis:AccessGateMatrix ;
    dis:matrixRole b:insurance-claimant ;
    dis:matrixEntity b:adjudicated-claim ;
    dis:allowedMode dis:READ ;
    dis:name "Claimant claim status gate" ;
    dis:description "Claimant tracks claim progress." .

# Agent Gates (Concierge executing on behalf of roles)
b:gate-agent-location a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:public-branch-location ;
    dis:allowedMode dis:READ ;
    dis:name "Agent location gate" ;
    dis:description "Agent reads branch locator." .

b:gate-agent-dda a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:demand-deposit-account ;
    dis:allowedMode dis:READ ;
    dis:name "Agent DDA gate" ;
    dis:description "Agent queries balances." .

b:gate-agent-transfer a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:account-transfer-record ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Agent transfer gate" ;
    dis:description "Agent submits transfer." .

b:gate-agent-dispute a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:transaction-dispute ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Agent dispute gate" ;
    dis:description "Agent files dispute." .

b:gate-agent-card a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:cardholder-debit-card ;
    dis:allowedMode dis:UPDATE ;
    dis:allowedFunction b:fn-freeze-debit-card ;
    dis:name "Agent card freeze gate (scoped)" ;
    dis:description "Agent executes card freeze in Fiserv." .

b:gate-agent-fnol a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:first-notice-of-loss ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Agent FNOL gate" ;
    dis:description "Agent submits FNOL in Guidewire." .

b:gate-agent-coverage a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:insurance-policy-coverage ;
    dis:allowedMode dis:READ ;
    dis:name "Agent coverage gate" ;
    dis:description "Agent checks coverages." .

b:gate-agent-claim a dis:AccessGateMatrix ;
    dis:matrixRole b:bfsi-concierge-agent ;
    dis:matrixEntity b:adjudicated-claim ;
    dis:allowedMode dis:READ ;
    dis:name "Agent claim gate" ;
    dis:description "Agent queries claim status." .
