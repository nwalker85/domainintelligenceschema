@prefix dis: <https://schemas.domainintelligenceschema.org/dis/1.7.0/> .
@prefix h:   <https://dossier.ravenhelm.dev/healthcare/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://dossier.ravenhelm.dev/healthcare/> a owl:Ontology ;
    owl:versionInfo "1.8.0" ;
    dis:dossierType dis:DESIGN ;
    dis:dossierStatus dis:APPROVED ;
    rdfs:label "Healthcare Revenue Cycle Management & Patient Access Dossier" ;
    rdfs:comment "Decomposed patient access, appointment scheduling, proxy consent, and prescription refill operations across Epic Cadence, Cerner Millennium, and Surescripts." .

# =============================================================================
# 1. SYSTEMS LAYER (Systems of Record)
# =============================================================================

h:epic-cadence-mychart a dis:Application ;
    dis:name "Epic Cadence & MyChart API" ;
    dis:description "Enterprise scheduling, digital front door, and FHIR R4 appointment management engine." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://epic-gateway.healthsystem.local/api/FHIR/R4" ;
    dis:authMethod dis:OAUTH2 .

h:cerner-millennium-ehr a dis:Application ;
    dis:name "Cerner Millennium EHR" ;
    dis:description "Master Patient Index (MPI), demographic intake, and clinical charting system." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://cerner-fhir.healthsystem.local/r4" ;
    dis:authMethod dis:BEARER .

h:meditech-expanse-ehr a dis:Application ;
    dis:name "MEDITECH Expanse EHR" ;
    dis:description "Enterprise acute and ambulatory EHR platform providing REST scheduling APIs for community hospital networks." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://meditech-rest.healthsystem.local/v1" ;
    dis:authMethod dis:OAUTH2 .

h:surescripts-network a dis:Application ;
    dis:name "Surescripts E-Prescribing Gateway" ;
    dis:description "National electronic prescription routing, pharmacy benefit verification, and electronic refill authorization network." ;
    dis:applicationType dis:SYSTEM_OF_RECORD ;
    dis:networkScope dis:SCOPE_PUBLIC ;
    dis:baseUrl "https://surescripts-gateway.healthsystem.local/v2" ;
    dis:authMethod dis:OAUTH2 .

# --- Endpoints ---

h:ep-epic-confirm-appointment a dis:Endpoint ;
    dis:name "Epic Confirm Appointment" ;
    dis:description "Transitions appointment status to CONFIRMED in Epic Cadence." ;
    dis:hostedBy h:epic-cadence-mychart ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Appointment/{id}/$confirm" ;
    dis:mutates true .

h:ep-epic-cancel-appointment a dis:Endpoint ;
    dis:name "Epic Cancel Appointment" ;
    dis:description "Releases provider slot, applies cancellation reason, and notifies patient access in Epic Cadence." ;
    dis:hostedBy h:epic-cadence-mychart ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Appointment/{id}/$cancel" ;
    dis:mutates true .

h:ep-epic-reschedule-appointment a dis:Endpoint ;
    dis:name "Epic Reschedule Appointment" ;
    dis:description "Cancels current slot and books target provider slot in one transaction." ;
    dis:hostedBy h:epic-cadence-mychart ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Appointment/{id}/$reschedule" ;
    dis:mutates true .

h:ep-cerner-patient-lookup a dis:Endpoint ;
    dis:name "Cerner Patient Demographic Lookup" ;
    dis:description "Searches Master Patient Index (MPI) by MRN, name, DOB, and SSN last-4." ;
    dis:hostedBy h:cerner-millennium-ehr ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:GET ;
    dis:urlPath "/Patient/{id}" ;
    dis:mutates false .

h:ep-surescripts-request-refill a dis:Endpoint ;
    dis:name "Surescripts Submit Refill Request" ;
    dis:description "Submits clinical renewal request to physician inbox via Surescripts electronic routing." ;
    dis:hostedBy h:surescripts-network ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/RefillRequest" ;
    dis:mutates true .

h:ep-cerner-cancel-appointment a dis:Endpoint ;
    dis:name "Cerner Millennium Cancel Appointment" ;
    dis:description "Submits cancellation transaction to Cerner Millennium scheduling engine." ;
    dis:hostedBy h:cerner-millennium-ehr ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Appointment/{id}/$cancel" ;
    dis:mutates true ;
    dis:writesEntity h:clinical-appointment .

h:ep-meditech-cancel-appointment a dis:Endpoint ;
    dis:name "MEDITECH Expanse Cancel Appointment" ;
    dis:description "Releases appointment booking in MEDITECH Expanse scheduling registry." ;
    dis:hostedBy h:meditech-expanse-ehr ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/scheduling/appointments/{id}/cancel" ;
    dis:mutates true ;
    dis:writesEntity h:clinical-appointment .

h:ep-epic-get-proxy-consent a dis:Endpoint ;
    dis:name "Epic Proxy Consent Lookup" ;
    dis:description "Retrieves HIPAA caregiver proxy authorization and adolescent access tier." ;
    dis:hostedBy h:epic-cadence-mychart ;
    dis:transport dis:TRANSPORT_HTTPS ;
    dis:httpMethod dis:GET ;
    dis:urlPath "/Consent?category=proxy-access" ;
    dis:mutates false .

# --- Functions ---

h:fn-confirm-appointment a dis:FunctionCatalogEntry ;
    dis:name "Confirm Appointment Entry" ;
    dis:description "Executes appointment confirmation in Epic Cadence." ;
    dis:callsEndpoint h:ep-epic-confirm-appointment ;
    dis:readsEntity h:clinical-appointment ;
    dis:writesEntity h:clinical-appointment ;
    dis:inputFields "appointment_id,patient_mrn,confirmation_method" ;
    dis:outputFields "appointment_id,status,confirmed_timestamp" .

h:fn-cancel-appointment a dis:FunctionCatalogEntry ;
    dis:name "Cancel Appointment Entry (Epic Cadence)" ;
    dis:description "Executes appointment cancellation against Epic Systems substrate." ;
    dis:callsEndpoint h:ep-epic-cancel-appointment ;
    dis:readsEntity h:clinical-appointment ;
    dis:writesEntity h:clinical-appointment ;
    dis:inputFields "appointment_id,patient_mrn,cancellation_reason_code" ;
    dis:outputFields "appointment_id,status,cancellation_timestamp" .

h:fn-cerner-cancel-appointment a dis:FunctionCatalogEntry ;
    dis:name "Cancel Appointment Entry (Cerner Millennium)" ;
    dis:description "Executes appointment cancellation against Cerner Millennium substrate." ;
    dis:callsEndpoint h:ep-cerner-cancel-appointment ;
    dis:readsEntity h:clinical-appointment ;
    dis:writesEntity h:clinical-appointment ;
    dis:inputFields "appointment_id,patient_mrn,reason" ;
    dis:outputFields "appointment_id,status,cancelled_at" .

h:fn-meditech-cancel-appointment a dis:FunctionCatalogEntry ;
    dis:name "Cancel Appointment Entry (MEDITECH Expanse)" ;
    dis:description "Executes appointment cancellation against MEDITECH Expanse substrate." ;
    dis:callsEndpoint h:ep-meditech-cancel-appointment ;
    dis:readsEntity h:clinical-appointment ;
    dis:writesEntity h:clinical-appointment ;
    dis:inputFields "appointment_id,patient_mrn,reason" ;
    dis:outputFields "appointment_id,status,cancelled_at" .

h:fn-reschedule-appointment a dis:FunctionCatalogEntry ;
    dis:name "Reschedule Appointment Entry" ;
    dis:description "Re-allocates provider slot in Epic Cadence." ;
    dis:callsEndpoint h:ep-epic-reschedule-appointment ;
    dis:readsEntity h:clinical-appointment ;
    dis:writesEntity h:clinical-appointment ;
    dis:inputFields "appointment_id,patient_mrn,new_slot_id,provider_id" ;
    dis:outputFields "appointment_id,new_start_time,new_location,status" .

h:fn-lookup-patient a dis:FunctionCatalogEntry ;
    dis:name "Lookup Patient Account" ;
    dis:description "Fetches demographic and MPI record from Cerner Millennium." ;
    dis:callsEndpoint h:ep-cerner-patient-lookup ;
    dis:readsEntity h:patient-account ;
    dis:inputFields "patient_id,date_of_birth" ;
    dis:outputFields "patient_id,mrn,guarantor_id,active_pcp,coverage_status" .

h:fn-submit-refill a dis:FunctionCatalogEntry ;
    dis:name "Submit Refill Request" ;
    dis:description "Submits medication refill to Surescripts network." ;
    dis:callsEndpoint h:ep-surescripts-request-refill ;
    dis:readsEntity h:prescription-medication ;
    dis:writesEntity h:medication-refill-request ;
    dis:inputFields "patient_mrn,prescription_number,ndc_code,pharmacy_ncpdp" ;
    dis:outputFields "refill_request_id,status,transmission_receipt" .

h:fn-verify-proxy a dis:FunctionCatalogEntry ;
    dis:name "Verify Proxy Authorization" ;
    dis:description "Checks caregiver proxy legal consent in Epic MyChart." ;
    dis:callsEndpoint h:ep-epic-get-proxy-consent ;
    dis:readsEntity h:caregiver-proxy-consent ;
    dis:inputFields "patient_mrn,proxy_user_id" ;
    dis:outputFields "consent_id,status,proxy_relationship,access_tier,expiration_date" .

# =============================================================================
# 2. ROLES & ENTITIES
# =============================================================================

h:existing-patient a dis:Role ;
    dis:roleType "human" ;
    dis:name "Existing Patient" ;
    dis:description "Patient with verified Master Patient Index (MRN) and active clinical record." .

h:caregiver-proxy a dis:Role ;
    dis:roleType "human" ;
    dis:name "Caregiver Proxy" ;
    dis:description "Family member, guardian, or healthcare power of attorney acting on behalf of patient." .

h:rcm-navigator-agent a dis:Role ;
    dis:roleType "agent" ;
    dis:name "RCM Patient Access Navigator" ;
    dis:description "AI conversational agent facilitating scheduling, intake, and refill triage." .

# --- Entities ---

h:clinical-appointment a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Clinical Appointment" ;
    dis:description "Scheduled provider slot in Epic Cadence." .

h:patient-account a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Patient Account" ;
    dis:description "Cerner demographic, guarantor, and insurance coverage profile." .

h:prescription-medication a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Prescription Medication" ;
    dis:description "Active medication therapy record with NDC code, dosage, and prescriber." .

h:medication-refill-request a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Medication Refill Request" ;
    dis:description "Surescripts renewal transaction sent to prescribing physician." .

h:caregiver-proxy-consent a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Caregiver Proxy Consent" ;
    dis:description "Documented legal authorization granting third-party access to patient record." .

h:symptom-triage-escalation a dis:Entity ;
    dis:entityType "data" ;
    dis:name "Symptom Triage Escalation" ;
    dis:description "Direct handoff payload to on-call triage RN or emergency department." .

# =============================================================================
# 3. CLOSED POPULATIONS (Common Chronic & Mental Health Medications)
# =============================================================================

h:med-lisinopril a dis:EntityInstance ;
    dis:instanceOf h:prescription-medication ;
    dis:spokenForm "lisinopril", "prinivil", "zestril" ;
    dis:systemKey "RX-29046" ;
    dis:name "Lisinopril 10mg" ;
    dis:description "ACE inhibitor for hypertension, diabetic nephropathy, and heart failure." .

h:med-metformin a dis:EntityInstance ;
    dis:instanceOf h:prescription-medication ;
    dis:spokenForm "metformin", "glucophage" ;
    dis:systemKey "RX-6809" ;
    dis:name "Metformin 500mg" ;
    dis:description "Biguanide oral antihyperglycemic agent for Type 2 diabetes mellitus." .

h:med-sertraline a dis:EntityInstance ;
    dis:instanceOf h:prescription-medication ;
    dis:spokenForm "sertraline", "zoloft" ;
    dis:systemKey "RX-36437" ;
    dis:name "Sertraline 50mg" ;
    dis:description "Selective serotonin reuptake inhibitor (SSRI) for major depression and panic disorder." .

h:med-escitalopram a dis:EntityInstance ;
    dis:instanceOf h:prescription-medication ;
    dis:spokenForm "escitalopram", "lexapro" ;
    dis:systemKey "RX-32937" ;
    dis:name "Escitalopram 10mg" ;
    dis:description "SSRI antidepressant for generalized anxiety disorder (GAD) and depression." .

h:med-fluoxetine a dis:EntityInstance ;
    dis:instanceOf h:prescription-medication ;
    dis:spokenForm "fluoxetine", "prozac" ;
    dis:systemKey "RX-310385" ;
    dis:name "Fluoxetine 20mg" ;
    dis:description "SSRI for major depressive disorder and obsessive-compulsive disorder." .

h:med-bupropion a dis:EntityInstance ;
    dis:instanceOf h:prescription-medication ;
    dis:spokenForm "bupropion", "wellbutrin" ;
    dis:systemKey "RX-835603" ;
    dis:name "Bupropion XL 150mg" ;
    dis:description "Norepinephrine/dopamine-reuptake inhibitor (NDRI) for depression and smoking cessation." .

# =============================================================================
# 4. AGENTIC TRIPLETS
# =============================================================================

h:t1-confirm-appointment a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:boundFunction h:fn-confirm-appointment ;
    dis:stance dis:REACT ;
    dis:mode dis:UPDATE ;
    dis:targetEntity h:clinical-appointment ;
    dis:name "Confirm appointment" ;
    dis:description "Patient confirms attendance for scheduled clinical encounter in Epic Cadence." .

h:t2-cancel-appointment a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:boundFunction h:fn-cancel-appointment ;
    dis:stance dis:ACT ;
    dis:mode dis:UPDATE ;
    dis:targetEntity h:clinical-appointment ;
    dis:name "Cancel appointment" ;
    dis:description "Patient cancels appointment; releases provider slot in Epic." .

h:t3-reschedule-appointment a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:boundFunction h:fn-reschedule-appointment ;
    dis:stance dis:ACT ;
    dis:mode dis:UPDATE ;
    dis:targetEntity h:clinical-appointment ;
    dis:name "Reschedule appointment" ;
    dis:description "Patient reallocates slot to alternative provider or time." .

h:t4-escalate-symptom-triage a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:bindingStatus dis:MANUAL_PROCEDURE ;
    dis:unboundReason "Warm telephony transfer to registered triage nurse queue" ;
    dis:stance dis:ACT ;
    dis:mode dis:INITIATE ;
    dis:targetEntity h:symptom-triage-escalation ;
    dis:name "T4 escalate symptom triage" ;
    dis:description "Routes acute clinical symptoms or symptom reports to an RN triage nurse." .

h:t5-dispatch-emergency-crisis a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:bindingStatus dis:MANUAL_PROCEDURE ;
    dis:unboundReason "Emergency crisis deflection to 911 / emergency services" ;
    dis:stance dis:ACT ;
    dis:mode dis:INITIATE ;
    dis:targetEntity h:symptom-triage-escalation ;
    dis:name "T5 dispatch emergency crisis" ;
    dis:description "Directs patient experiencing life-threatening emergency or crisis to 911 services." .

h:t6-lookup-patient-account a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:boundFunction h:fn-lookup-patient ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity h:patient-account ;
    dis:name "Lookup patient account" ;
    dis:description "Verifies existing patient coverage and MPI status in Cerner." .

h:t7-request-prescription-refill a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:boundFunction h:fn-submit-refill ;
    dis:stance dis:ACT ;
    dis:mode dis:CREATE ;
    dis:targetEntity h:medication-refill-request ;
    dis:name "Submit refill request" ;
    dis:description "Submits refill request through Surescripts network." .

h:t8-verify-caregiver-proxy a dis:AgenticTriplet ;
    dis:actingRole h:rcm-navigator-agent ;
    dis:boundFunction h:fn-verify-proxy ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity h:caregiver-proxy-consent ;
    dis:name "Verify caregiver proxy consent" ;
    dis:description "Verifies legal proxy relationship before disclosing appointment or med data." .

# =============================================================================
# 5. GOVERNANCE & UTTERANCE POLICIES
# =============================================================================

h:notice-cancellation-policy a dis:EntityInstance ;
    dis:name "24-Hour Appointment Cancellation Policy Notice" ;
    dis:description "Mandatory notice of 24-hour advance notice to avoid late cancellation fee." ;
    dis:spokenForm "Please note that appointments cancelled within 24 hours are subject to a late cancellation fee." ;
    dis:instanceOf h:clinical-appointment ;
    dis:systemKey "RCM-NOTICE-CANCEL-24H" .

h:notice-hipaa-proxy a dis:EntityInstance ;
    dis:name "HIPAA Caregiver Proxy Consent Notice" ;
    dis:description "Notice confirming verified caregiver proxy designation on file." ;
    dis:spokenForm "Proxy consent verified on file under HIPAA regulations." ;
    dis:instanceOf h:caregiver-proxy-consent ;
    dis:systemKey "HIPAA-PROXY-NOTICE-01" .

h:p1-clinical-advice-prohibition a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:PROHIBITION ;
    dis:requirement "The care navigator must not offer medical diagnoses, treatment recommendations, or drug dosage advice. Any symptom query must escalate directly to a licensed clinician." ;
    dis:description "Strict separation of duty: medical assessment belongs exclusively to licensed clinical staff." ;
    dis:name "P1 clinical advice prohibition" ;
    dis:appliesToRole h:rcm-navigator-agent ;
    dis:appliesToTriplet h:t4-escalate-symptom-triage ;
    dis:liabilityClass dis:MEDICAL ;
    dis:onViolation dis:ESCALATE .

h:p2-emergency-symptom-escalation a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:PROHIBITION ;
    dis:requirement "Upon detection of acute distress, chest pain, or severe difficulty breathing, the agent must halt automated flow and direct the caller to call 911 or visit the nearest emergency department." ;
    dis:description "Emergency safety protocol: life safety conditions preempt scheduling workflows." ;
    dis:name "P2 emergency symptom escalation" ;
    dis:appliesToRole h:rcm-navigator-agent ;
    dis:appliesToTriplet h:t5-dispatch-emergency-crisis ;
    dis:liabilityClass dis:MEDICAL ;
    dis:onViolation dis:ESCALATE .

h:p3-hipaa-phi-notice a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:OBLIGATION ;
    dis:requirement "When a caller acts on behalf of a patient, verified proxy consent must be bound before appointment or medication details are disclosed." ;
    dis:description "Federal HIPAA Privacy Rule compliance." ;
    dis:name "P3 HIPAA PHI notice" ;
    dis:liabilityClass dis:REGULATORY ;
    dis:boundValue h:notice-hipaa-proxy ;
    dis:appliesToEntity h:caregiver-proxy-consent ;
    dis:appliesToTriplet h:t8-verify-caregiver-proxy ;
    dis:onViolation dis:REFUSE .

h:p4-cancellation-notice a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:OBLIGATION ;
    dis:requirement "Before confirming cancellation, the agent must state the clinic's 24-hour advance notice policy to prevent late cancellation fees." ;
    dis:description "Financial and administrative clinic policy notification." ;
    dis:name "P4 cancellation notice" ;
    dis:liabilityClass dis:STANDARD ;
    dis:boundValue h:notice-cancellation-policy ;
    dis:appliesToTriplet h:t2-cancel-appointment ;
    dis:onViolation dis:REFUSE .

h:p5-greeting-scope a dis:UtterancePolicy ;
    dis:enforcement dis:INSTRUCTED ;
    dis:policyType dis:LIFECYCLE ;
    dis:requirement "Opening greeting must identify the virtual care navigator and explicitly clarify that it assists with scheduling and clinic information, not medical emergencies or clinical diagnosis." ;
    dis:description "Explicit clinical scope boundaries delivered at start of interaction." ;
    dis:name "P5 greeting scope" ;
    dis:liabilityClass dis:STANDARD ;
    dis:lifecyclePhase dis:GREETING ;
    dis:onViolation dis:LOG_ONLY .

h:p6-controlled-substances-prohibition a dis:UtterancePolicy ;
    dis:name "Prohibit automated controlled substance refills" ;
    dis:description "Enforces DEA Schedule II-V prohibitions against conversational automated refills." ;
    dis:policyType dis:PROHIBITION ;
    dis:enforcement dis:STRUCTURAL ;
    dis:liabilityClass dis:REGULATORY ;
    dis:onViolation dis:REFUSE ;
    dis:requirement "The agent must never process automated refills for opioids, benzodiazepines, or stimulants. Must deflect to prescribing physician clinic." ;
    dis:appliesToTriplet h:t7-request-prescription-refill ;
    dis:appliesToEntity h:medication-refill-request .

h:p7-refill-disclosure-limit a dis:UtterancePolicy ;
    dis:name "Refill status disclosure limit" ;
    dis:description "Limits verbal confirmation to medication name, days supply, and target pharmacy; suppresses internal diagnosis codes." ;
    dis:policyType dis:DISCLOSURE_LIMIT ;
    dis:enforcement dis:STRUCTURAL ;
    dis:liabilityClass dis:STANDARD ;
    dis:onViolation dis:REDACT ;
    dis:requirement "Verbal confirmation discloses medication name, strength, and receiving pharmacy. Excludes ICD-10 indication codes." ;
    dis:appliesToTriplet h:t7-request-prescription-refill ;
    dis:appliesToEntity h:medication-refill-request .

# =============================================================================
# 6. GRAMMAR MATRICES (Denials are the Model)
# =============================================================================

h:emm-appointment a dis:EntityModeMatrix ;
    dis:matrixEntity h:clinical-appointment ;
    dis:supportedMode dis:READ , dis:UPDATE ;
    dis:name "Appointment supports READ, UPDATE" ;
    dis:description "Appointments are confirmed, rescheduled, or cancelled (UPDATE). Cannot be deleted from EHR audit trail." .

h:emm-patient a dis:EntityModeMatrix ;
    dis:matrixEntity h:patient-account ;
    dis:supportedMode dis:READ ;
    dis:name "Patient account supports READ" ;
    dis:description "Demographic lookup only. Patient creation is reserved for backoffice registrar." .

h:emm-medication a dis:EntityModeMatrix ;
    dis:matrixEntity h:prescription-medication ;
    dis:supportedMode dis:READ ;
    dis:name "Medication supports READ" ;
    dis:description "Medication catalog is read-only." .

h:emm-refill a dis:EntityModeMatrix ;
    dis:matrixEntity h:medication-refill-request ;
    dis:supportedMode dis:CREATE , dis:READ ;
    dis:name "Refill request supports CREATE, READ" ;
    dis:description "Submitted renewal requests are immutable once sent to Surescripts." .

h:emm-consent a dis:EntityModeMatrix ;
    dis:matrixEntity h:caregiver-proxy-consent ;
    dis:supportedMode dis:READ ;
    dis:name "Proxy consent supports READ" ;
    dis:description "HIPAA consent documentation is read-only in access workflows." .

h:emm-triage a dis:EntityModeMatrix ;
    dis:matrixEntity h:symptom-triage-escalation ;
    dis:supportedMode dis:INITIATE ;
    dis:name "Triage supports INITIATE" ;
    dis:description "Conversational handoff to human clinical nurse." .

# --- Access Gates ---

h:gate-navigator-appointment a dis:AccessGateMatrix ;
    dis:matrixRole h:rcm-navigator-agent ;
    dis:matrixEntity h:clinical-appointment ;
    dis:allowedMode dis:READ , dis:UPDATE ;
    dis:name "Navigator appointment gate" ;
    dis:description "Navigator may update appointment status via confirmed/cancel/reschedule functions across Epic, Cerner, and MEDITECH substrates." ;
    dis:allowedFunction h:fn-confirm-appointment ;
    dis:allowedFunction h:fn-cancel-appointment ;
    dis:allowedFunction h:fn-cerner-cancel-appointment ;
    dis:allowedFunction h:fn-meditech-cancel-appointment ;
    dis:allowedFunction h:fn-reschedule-appointment .

h:gate-navigator-patient a dis:AccessGateMatrix ;
    dis:matrixRole h:rcm-navigator-agent ;
    dis:matrixEntity h:patient-account ;
    dis:allowedMode dis:READ ;
    dis:name "Navigator patient lookup gate" ;
    dis:description "Navigator reads demographic record for verification." .

h:gate-navigator-med a dis:AccessGateMatrix ;
    dis:matrixRole h:rcm-navigator-agent ;
    dis:matrixEntity h:prescription-medication ;
    dis:allowedMode dis:READ ;
    dis:name "Navigator med catalog gate" ;
    dis:description "Navigator inspects active prescriptions." .

h:gate-navigator-refill a dis:AccessGateMatrix ;
    dis:matrixRole h:rcm-navigator-agent ;
    dis:matrixEntity h:medication-refill-request ;
    dis:allowedMode dis:CREATE , dis:READ ;
    dis:name "Navigator refill submission gate" ;
    dis:description "Navigator submits electronic refill request." .

h:gate-navigator-consent a dis:AccessGateMatrix ;
    dis:matrixRole h:rcm-navigator-agent ;
    dis:matrixEntity h:caregiver-proxy-consent ;
    dis:allowedMode dis:READ ;
    dis:name "Navigator proxy consent gate" ;
    dis:description "Navigator inspects proxy consent authorization." .

h:gate-navigator-triage a dis:AccessGateMatrix ;
    dis:matrixRole h:rcm-navigator-agent ;
    dis:matrixEntity h:symptom-triage-escalation ;
    dis:allowedMode dis:INITIATE ;
    dis:name "Navigator triage handoff gate" ;
    dis:description "Navigator initiates emergency / clinical triage transfer." .
