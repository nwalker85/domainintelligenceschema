@prefix dis: <https://schemas.domainintelligenceschema.org/dis/1.7.0/> .
@prefix h:   <https://dossier.ravenhelm.dev/healthcare/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://dossier.ravenhelm.dev/healthcare/> a owl:Ontology ;
    dct:title "Aegis Health Patient Care & Scheduling Navigation" ;
    dis:dossierType dis:DESIGN ;
    dis:dossierStatus dis:DRAFT ;
    owl:versionInfo "1.0.0" .

# ---------- Roles ----------
h:patient a dis:Role ;
    dis:roleType "human" ;
    dis:description "Patient or caregiver seeking clinic scheduling or facility information." ;
    dis:name "Patient" .

h:care-navigator a dis:Role ;
    dis:roleType "agent" ;
    dis:description "Automated navigation assistant handling appointment bookings, clinic hours, and triage routing." ;
    dis:name "Care Navigator Agent" .

h:licensed-clinician a dis:Role ;
    dis:roleType "human" ;
    dis:description "Registered nurse or physician holding sole authority for medical evaluation and triage." ;
    dis:name "Licensed Clinician" .

h:clinic-receptionist a dis:Role ;
    dis:roleType "human" ;
    dis:description "Clinic front desk staff handling in-person check-in and local rescheduling." ;
    dis:name "Clinic Receptionist" .

h:privacy-officer a dis:Role ;
    dis:roleType "human" ;
    dis:description "HIPAA compliance officer overseeing patient health information disclosure." ;
    dis:name "Privacy Officer" .

# ---------- Entities ----------
h:appointment a dis:Entity ;
    dis:entityType "data" ;
    dis:description "Patient clinical appointment slot, time, clinician, and booking status." ;
    dis:name "Appointment" .

h:cliniclocation a dis:Entity ;
    dis:entityType "data" ;
    dis:description "Outpatient clinic facilities, address, operating hours, and specialty departments." ;
    dis:name "ClinicLocation" .

h:patientrecord a dis:Entity ;
    dis:entityType "data" ;
    dis:description "Protected Health Information (PHI) patient profile and identity record." ;
    dis:name "PatientRecord" .

h:symptomreport a dis:Entity ;
    dis:entityType "data" ;
    dis:description "Inbound patient symptom description or chief complaint." ;
    dis:name "SymptomReport" .

h:emergencyqueue a dis:Entity ;
    dis:entityType "data" ;
    dis:description "Emergency medical dispatch (911) or urgent crisis transfer queue." ;
    dis:name "EmergencyQueue" .

# ---------- Systems Layer ----------
h:ehr-scheduling-api a dis:Application ;
    dis:applicationType dis:SAAS_PLATFORM ;
    dis:authMethod dis:OAUTH2 ;
    dis:baseUrl "https://ehr.example.health/fhir/v4" ;
    dis:description "FHIR-compliant electronic health record scheduling and location service." ;
    dis:name "EHR Scheduling Gateway" .

h:get-clinic-hours a dis:Endpoint ;
    dis:hostedBy h:ehr-scheduling-api ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Location/hours" ;
    dis:mutates false ;
    dis:description "Retrieves public clinic facility hours and available care specialties." ;
    dis:name "Get clinic hours" .

h:get-appointment-status a dis:Endpoint ;
    dis:hostedBy h:ehr-scheduling-api ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Appointment/status" ;
    dis:mutates false ;
    dis:description "Queries upcoming confirmed clinical appointments for a verified patient." ;
    dis:name "Get appointment status" .

h:post-cancel-appointment a dis:Endpoint ;
    dis:hostedBy h:ehr-scheduling-api ;
    dis:httpMethod dis:POST ;
    dis:urlPath "/Appointment/cancel" ;
    dis:mutates true ;
    dis:description "Cancels an existing appointment slot in the EHR." ;
    dis:name "Cancel appointment" .

h:fn-read-clinic-hours a dis:FunctionCatalogEntry ;
    dis:callsEndpoint h:get-clinic-hours ;
    dis:readsEntity h:cliniclocation ;
    dis:inputFields "facility_id" ;
    dis:outputFields "facility_id,facility_name,operating_hours,specialties" ;
    dis:description "Retrieves operating hours and department information for a clinic." ;
    dis:name "Read clinic hours" .

h:fn-read-appointment-status a dis:FunctionCatalogEntry ;
    dis:callsEndpoint h:get-appointment-status ;
    dis:readsEntity h:appointment ;
    dis:inputFields "patient_id,date_of_birth,appointment_id" ;
    dis:outputFields "appointment_id,clinician_name,start_time,location_name,status" ;
    dis:description "Retrieves confirmed appointment details for a patient." ;
    dis:name "Read appointment status" .

h:fn-cancel-appointment a dis:FunctionCatalogEntry ;
    dis:callsEndpoint h:post-cancel-appointment ;
    dis:readsEntity h:appointment ;
    dis:writesEntity h:appointment ;
    dis:inputFields "patient_id,appointment_id,reason" ;
    dis:outputFields "appointment_id,status,cancellation_timestamp" ;
    dis:description "Executes cancellation of a booked appointment in EHR." ;
    dis:name "Cancel appointment entry" .

# ---------- Agentic Triplets ----------
h:t1-read-clinic-hours a dis:AgenticTriplet ;
    dis:actingRole h:care-navigator ;
    dis:boundFunction h:fn-read-clinic-hours ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity h:cliniclocation ;
    dis:description "Caller asks for clinic hours or available locations." ;
    dis:name "T1 read clinic hours" .

h:t2-read-appointment-status a dis:AgenticTriplet ;
    dis:actingRole h:care-navigator ;
    dis:boundFunction h:fn-read-appointment-status ;
    dis:stance dis:REACT ;
    dis:mode dis:READ ;
    dis:targetEntity h:appointment ;
    dis:description "Patient checks time or doctor for an existing appointment." ;
    dis:name "T2 read appointment status" .

h:t3-cancel-appointment a dis:AgenticTriplet ;
    dis:actingRole h:care-navigator ;
    dis:boundFunction h:fn-cancel-appointment ;
    dis:stance dis:ACT ;
    dis:mode dis:UPDATE ;
    dis:targetEntity h:appointment ;
    dis:description "Patient requests cancellation of a scheduled appointment." ;
    dis:name "T3 cancel appointment" .

h:t4-escalate-symptom-triage a dis:AgenticTriplet ;
    dis:actingRole h:care-navigator ;
    dis:stance dis:ACT ;
    dis:mode dis:INITIATE ;
    dis:targetEntity h:symptomreport ;
    dis:description "Routes symptom reports to a licensed clinical triage nurse." ;
    dis:name "T4 escalate symptom triage" .

h:t5-dispatch-emergency-crisis a dis:AgenticTriplet ;
    dis:actingRole h:care-navigator ;
    dis:stance dis:ACT ;
    dis:mode dis:INITIATE ;
    dis:targetEntity h:emergencyqueue ;
    dis:description "Directs patient experiencing life-threatening emergency to 911/emergency services." ;
    dis:name "T5 dispatch emergency crisis" .

# ---------- Utterance Policies (Medical Liability Boundary) ----------
h:p1-clinical-advice-prohibition a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:PROHIBITION ;
    dis:requirement "The care navigator must not offer medical diagnoses, treatment recommendations, or drug dosage advice. Any symptom query must escalate directly to a licensed clinician." ;
    dis:description "Strict separation of duty: medical assessment belongs exclusively to licensed clinical staff." ;
    dis:name "P1 clinical advice prohibition" ;
    dis:appliesToRole h:care-navigator ;
    dis:appliesToTriplet h:t4-escalate-symptom-triage ;
    dis:liabilityClass dis:MEDICAL ;
    dis:onViolation dis:ESCALATE .

h:p2-emergency-symptom-escalation a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:PROHIBITION ;
    dis:requirement "Upon detection of acute distress, chest pain, or severe difficulty breathing, the agent must halt automated flow and direct the caller to call 911 or visit the nearest emergency department." ;
    dis:description "Emergency safety protocol: life safety conditions preempt scheduling workflows." ;
    dis:name "P2 emergency symptom escalation" ;
    dis:appliesToRole h:care-navigator ;
    dis:appliesToTriplet h:t5-dispatch-emergency-crisis ;
    dis:liabilityClass dis:MEDICAL ;
    dis:onViolation dis:ESCALATE .

h:p3-hipaa-phi-notice a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:OBLIGATION ;
    dis:requirement "Any utterance disclosing patient appointment details must be preceded by verified identity and carry the HIPAA privacy disclosure statement." ;
    dis:description "Federal HIPAA Privacy Rule compliance." ;
    dis:name "P3 HIPAA PHI notice" ;
    dis:liabilityClass dis:REGULATORY ;
    dis:boundValue h:hipaa-privacy-notice-disclosure ;
    dis:appliesToEntity h:patientrecord ;
    dis:appliesToTriplet h:t2-read-appointment-status ;
    dis:onViolation dis:REFUSE .

h:p4-cancellation-notice a dis:UtterancePolicy ;
    dis:enforcement dis:STRUCTURAL ;
    dis:policyType dis:OBLIGATION ;
    dis:requirement "Before confirming cancellation, the agent must state the clinic's 24-hour advance notice policy to prevent late cancellation fees." ;
    dis:description "Financial and administrative clinic policy notification." ;
    dis:name "P4 cancellation notice" ;
    dis:liabilityClass dis:STANDARD ;
    dis:boundValue h:cancellation-policy-statement ;
    dis:appliesToTriplet h:t3-cancel-appointment ;
    dis:onViolation dis:REFUSE .

h:p5-greeting-scope a dis:UtterancePolicy ;
    dis:enforcement dis:INSTRUCTED ;
    dis:policyType dis:LIFECYCLE ;
    dis:requirement "Opening greeting must identify the virtual care navigator and explicitly clarify that it assists with scheduling and clinic information, not medical emergencies or clinical diagnosis." ;
    dis:description "Explicit clinical scope boundaries delivered at start of interaction." ;
    dis:name "P5 greeting scope" ;
    dis:liabilityClass dis:STANDARD ;
    dis:lifecyclePhase dis:GREETING ;
    dis:onViolation dis:LOG_ONLY .

# ---------- Entity-Mode Matrices ----------
h:emm-appointment a dis:EntityModeMatrix ;
    dis:matrixEntity h:appointment ;
    dis:supportedMode dis:READ ;
    dis:supportedMode dis:UPDATE ;
    dis:description "Appointments may be read for verification and updated for cancellation." ;
    dis:name "appointment supports READ, UPDATE" .

h:emm-cliniclocation a dis:EntityModeMatrix ;
    dis:matrixEntity h:cliniclocation ;
    dis:supportedMode dis:READ ;
    dis:description "Clinic locations and hours are public read-only information." ;
    dis:name "cliniclocation supports READ" .

h:emm-patientrecord a dis:EntityModeMatrix ;
    dis:matrixEntity h:patientrecord ;
    dis:supportedMode dis:READ ;
    dis:description "Patient records are read under verified HIPAA consent." ;
    dis:name "patientrecord supports READ" .

h:emm-symptomreport a dis:EntityModeMatrix ;
    dis:matrixEntity h:symptomreport ;
    dis:supportedMode dis:CREATE ;
    dis:supportedMode dis:INITIATE ;
    dis:description "Symptom reports are captured and handed off to human clinical triage." ;
    dis:name "symptomreport supports CREATE, INITIATE" .

h:emm-emergencyqueue a dis:EntityModeMatrix ;
    dis:matrixEntity h:emergencyqueue ;
    dis:supportedMode dis:INITIATE ;
    dis:description "Emergency queue exists solely as an escalation handoff target." ;
    dis:name "emergencyqueue supports INITIATE" .

# ---------- Access Gate Matrices ----------
h:gate-patient-cliniclocation a dis:AccessGateMatrix ;
    dis:matrixRole h:patient ;
    dis:matrixEntity h:cliniclocation ;
    dis:allowedMode dis:READ ;
    dis:description "Patients can read public clinic information." ;
    dis:name "patient -> cliniclocation: READ" .

h:gate-patient-appointment a dis:AccessGateMatrix ;
    dis:matrixRole h:patient ;
    dis:matrixEntity h:appointment ;
    dis:allowedMode dis:READ ;
    dis:allowedMode dis:UPDATE ;
    dis:description "Patients can check or cancel their own appointments." ;
    dis:name "patient -> appointment: READ, UPDATE" .

h:gate-care-navigator-cliniclocation a dis:AccessGateMatrix ;
    dis:matrixRole h:care-navigator ;
    dis:matrixEntity h:cliniclocation ;
    dis:allowedMode dis:READ ;
    dis:description "Care navigator reads facility directories." ;
    dis:name "care-navigator -> cliniclocation: READ" .

h:gate-care-navigator-appointment a dis:AccessGateMatrix ;
    dis:matrixRole h:care-navigator ;
    dis:matrixEntity h:appointment ;
    dis:allowedMode dis:READ ;
    dis:allowedMode dis:UPDATE ;
    dis:description "Care navigator looks up and cancels appointments." ;
    dis:name "care-navigator -> appointment: READ, UPDATE" .

h:gate-care-navigator-symptomreport a dis:AccessGateMatrix ;
    dis:matrixRole h:care-navigator ;
    dis:matrixEntity h:symptomreport ;
    dis:allowedMode dis:INITIATE ;
    dis:description "Care navigator initiates escalation of symptom reports to nurses." ;
    dis:name "care-navigator -> symptomreport: INITIATE" .

h:gate-care-navigator-emergencyqueue a dis:AccessGateMatrix ;
    dis:matrixRole h:care-navigator ;
    dis:matrixEntity h:emergencyqueue ;
    dis:allowedMode dis:INITIATE ;
    dis:description "Care navigator initiates handoff to emergency dispatch." ;
    dis:name "care-navigator -> emergencyqueue: INITIATE" .

h:gate-clinician-symptomreport a dis:AccessGateMatrix ;
    dis:matrixRole h:licensed-clinician ;
    dis:matrixEntity h:symptomreport ;
    dis:allowedMode dis:READ ;
    dis:allowedMode dis:RESPOND ;
    dis:description "Only licensed clinicians have authority to evaluate symptoms and respond with clinical guidance." ;
    dis:name "licensed-clinician -> symptomreport: READ, RESPOND" .

# ---------- Entity Instances ----------
h:loc-metro-family-health a dis:EntityInstance ;
    dis:instanceOf h:cliniclocation ;
    dis:spokenForm "Metro Family Health Pavilion" ;
    dis:confusableWith h:loc-metro-pediatric-clinic ;
    dis:systemKey "clinic-loc-101" ;
    dis:name "Metro Family Health Pavilion" .

h:loc-metro-pediatric-clinic a dis:EntityInstance ;
    dis:instanceOf h:cliniclocation ;
    dis:spokenForm "Metro Pediatric Care Clinic" ;
    dis:systemKey "clinic-loc-102" ;
    dis:name "Metro Pediatric Care Clinic" .

h:loc-downtown-urgent-care a dis:EntityInstance ;
    dis:instanceOf h:cliniclocation ;
    dis:spokenForm "Downtown Urgent Care Center" ;
    dis:systemKey "clinic-loc-201" ;
    dis:name "Downtown Urgent Care Center" .
