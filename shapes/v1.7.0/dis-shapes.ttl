@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix dis: <https://schemas.domainintelligenceschema.org/dis/1.7.0/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# A shape either DEFINES a construct (appears in the palette, renders a form) or
# merely CONSTRAINS one (validation only). Inferring from sh:targetClass cannot
# tell them apart — several shapes target the same class. Mark it explicitly.
dis:paletteConstruct a rdf:Property ;
    rdfs:label "palette construct" ;
    rdfs:comment "true when this shape defines a construct the workshop can place on a canvas." .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Every placeable construct requires exactly one name and one description.
# Declared once and referenced by sh:property IRI (valid SHACL: a PropertyShape
# can be named and reused, not only written inline) instead of repeated as an
# inline blank node on each NodeShape — nine copies had drifted out of sync
# before this fix: three were missing sh:maxCount 1, silently allowing more
# than one name or description where every other copy allowed exactly one.
dis:RequiredNameShape a sh:PropertyShape ;
    sh:path dis:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

dis:RequiredDescriptionShape a sh:PropertyShape ;
    sh:path dis:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

# ---------- AgenticTriplet — the Grammar Validity Matrix, mechanised ----------
dis:AgenticTripletShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:AgenticTriplet ;
    sh:name "Agentic triplet" ;
    sh:description "A statement: a Role acts on an Entity in one of seven modes." ;
    sh:order 30 ;
    sh:group dis:BehaviourGroup ;
    sh:closed true ;
    sh:ignoredProperties ( <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ) ;

    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;

    # "may a Role act on an Entity?" — the line-224 question, as a shape
    sh:property [ sh:path dis:actingRole ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Role ;
                  sh:message "actingRole must reference a dis:Role" ] ;
    sh:property [ sh:path dis:targetEntity ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Entity ;
                  sh:message "targetEntity must reference a dis:Entity — not a Role" ] ;

    # the closed grammar: seven modes, two stances. Do not invent verbs.
    sh:property [ sh:path dis:mode ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Mode ;
                  sh:message "mode must be one of the seven protocol modes" ] ;
    sh:property [ sh:path dis:stance ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( dis:ACT dis:REACT ) ;
                  sh:message "stance must be ACT or REACT" ] ;
    sh:property [ sh:path dis:boundFunction ; sh:class dis:FunctionCatalogEntry ] ;
    sh:property [ sh:path dis:bindingStatus ; sh:class dis:BindingStatus ; sh:maxCount 1 ] ;
    sh:property [ sh:path dis:unboundReason ; sh:datatype xsd:string ; sh:maxCount 1 ] .

# ---------- UtterancePolicy ----------
dis:UtterancePolicyShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:UtterancePolicy ;
    sh:name "Utterance policy" ;
    sh:description "What the agent may SAY — separate from what it may DO." ;
    sh:order 40 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:requirement ; sh:minCount 1 ;
                  sh:message "a policy must state its rule" ] ;
    sh:property [ sh:path dis:policyType ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( dis:OBLIGATION dis:PROHIBITION dis:DISCLOSURE_LIMIT dis:LIFECYCLE ) ] ;
    sh:property [ sh:path dis:enforcement ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( dis:STRUCTURAL dis:INSTRUCTED dis:ADVISORY ) ;
                  sh:message "enforcement must be declared — it is the whole point of the field" ] ;
    sh:property [ sh:path dis:appliesToTriplet ; sh:class dis:AgenticTriplet ] ;
    sh:property [ sh:path dis:appliesToEntity ; sh:class dis:Entity ;
                  sh:message "the entity this policy governs utterances about" ] ;
    # Declared so it can be COLLECTED, not just constrained. The sh:or below
    # enforces it for OBLIGATION; without an sh:property block no form can offer it.
    sh:property [ sh:path dis:boundValue ; sh:nodeKind sh:IRI ;
                  sh:message "a value the utterance must carry — for OBLIGATION this is required" ] ;
    sh:property [ sh:path dis:lifecyclePhase ; sh:maxCount 1 ;
                  sh:in ( dis:GREETING dis:HOLDING dis:ERROR dis:CLOSING dis:HANDOFF ) ;
                  sh:message "for LIFECYCLE policies — the phase this utterance belongs to" ] ;
    sh:property [ sh:path dis:liabilityClass ; sh:maxCount 1 ;
                  sh:in ( dis:STANDARD dis:REGULATORY dis:MEDICAL dis:FINANCIAL dis:SAFETY ) ;
                  sh:message "drives escalation thresholds — not all violations cost the same" ] ;
    sh:property [ sh:path dis:onViolation ; sh:maxCount 1 ;
                  sh:in ( dis:REFUSE dis:ESCALATE dis:SUPPRESS dis:REDACT dis:LOG_ONLY ) ;
                  sh:message "what the agent does when the policy would be breached" ] ;
    sh:property [ sh:path dis:appliesToRole ; sh:class dis:Role ;
                  sh:message "whose speech is constrained" ] ;

    # An OBLIGATION that binds no value obliges nothing.
    sh:or (
      [ sh:not [ sh:property [ sh:path dis:policyType ; sh:hasValue dis:OBLIGATION ] ] ]
      [ sh:property [ sh:path dis:boundValue ; sh:minCount 1 ] ]
    ) ;
    sh:message "an OBLIGATION must bind at least one value that the utterance has to carry" .

# ---------- vocabulary conformance: enum values must exist in dis.ttl ----------
dis:VocabularyBoundShape a sh:NodeShape ;
    sh:targetClass dis:UtterancePolicy ;
    sh:property [ sh:path dis:liabilityClass ; sh:class dis:LiabilityClass ;
                  sh:message "liabilityClass must be a term declared in the DIS vocabulary" ] ;
    sh:property [ sh:path dis:onViolation ; sh:class dis:ViolationAction ;
                  sh:message "onViolation must be a term declared in the DIS vocabulary" ] ;
    sh:property [ sh:path dis:policyType ; sh:class dis:PolicyType ] ;
    sh:property [ sh:path dis:enforcement ; sh:class dis:Enforcement ] .

# ---------- LIFECYCLE must name its phase ----------
dis:LifecycleNeedsPhaseShape a sh:NodeShape ;
    sh:targetClass dis:UtterancePolicy ;
    sh:or (
      [ sh:not [ sh:property [ sh:path dis:policyType ; sh:hasValue dis:LIFECYCLE ] ] ]
      [ sh:property [ sh:path dis:lifecyclePhase ; sh:minCount 1 ] ]
    ) ;
    sh:message "a LIFECYCLE policy must name its phase" .

# ---------- STRUCTURAL enforcement on a MEDICAL policy must bind a value ----------
dis:StructuralMedicalShape a sh:NodeShape ;
    sh:targetClass dis:UtterancePolicy ;
    sh:or (
      [ sh:not [ sh:property [ sh:path dis:liabilityClass ; sh:hasValue dis:MEDICAL ] ] ]
      [ sh:property [ sh:path dis:enforcement ; sh:hasValue dis:STRUCTURAL ] ]
    ) ;
    sh:severity sh:Warning ;
    sh:message "a MEDICAL-class policy enforced only by instruction is a known failure mode" .

# ---------- Role / Entity ----------
dis:RoleShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:Role ;
    sh:name "Role" ;
    sh:description "Who acts. A capacity an actor embodies." ;
    sh:order 10 ;
    sh:group dis:PeopleGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:roleType ; sh:minCount 1 ;
                  sh:in ( "human" "agent" "system" ) ] .

dis:EntityShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:Entity ;
    sh:name "Entity" ;
    sh:description "What is acted upon. A business object." ;
    sh:order 20 ;
    sh:group dis:PeopleGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:entityType ; sh:minCount 1 ; sh:in ( "data" "agent" ) ] .


# ---------- property groups — the palette's section headers ----------
dis:PeopleGroup     a sh:PropertyGroup ; rdfs:label "People and responsibility" ; sh:order 10 .
dis:SystemsGroup    a sh:PropertyGroup ; rdfs:label "Systems and access"        ; sh:order 20 .
dis:BehaviourGroup  a sh:PropertyGroup ; rdfs:label "Behaviour"                 ; sh:order 30 .
dis:GovernanceGroup a sh:PropertyGroup ; rdfs:label "Governance"                ; sh:order 40 .


# ---------- views — the dossier at one altitude at a time ----------
# A view is a projection, in the same sense the palette is: it declares which
# constructs are on the canvas and lets the rest fall away. This is the C4 move
# — a context diagram is not a different model, it is the same model asked a
# narrower question. Add a view here and it appears in the workshop.
dis:View a rdfs:Class ;
    rdfs:label "view" ;
    rdfs:comment "A named subset of the dossier's constructs, for one conversation." .

dis:showsConstruct a rdf:Property ;
    rdfs:label "shows construct" ;
    rdfs:comment "a class this view puts on the canvas; everything else is hidden, not removed." .

dis:ActorsView a dis:View ;
    rdfs:label "Actors" ;
    rdfs:comment "Who is in this domain, and what they act on. The first question in any scoping session." ;
    sh:order 10 ;
    dis:showsConstruct dis:Role, dis:Entity .

dis:BehaviourView a dis:View ;
    rdfs:label "Behaviour" ;
    rdfs:comment "What the agent may do — every triplet, with the roles and entities it binds." ;
    sh:order 20 ;
    dis:showsConstruct dis:Role, dis:Entity, dis:AgenticTriplet .

dis:GovernanceView a dis:View ;
    rdfs:label "Governance" ;
    rdfs:comment "The policy layer sitting over behaviour. What must, must never, and on whose authority." ;
    sh:order 30 ;
    dis:showsConstruct dis:AgenticTriplet, dis:UtterancePolicy .

dis:FullView a dis:View ;
    rdfs:label "Everything" ;
    rdfs:comment "The whole dossier. Useful for review, hard to talk over." ;
    sh:order 40 ;
    dis:showsConstruct dis:Role, dis:Entity, dis:AgenticTriplet, dis:UtterancePolicy,
        dis:Application, dis:Endpoint, dis:FunctionCatalogEntry,
        dis:EntityModeMatrix, dis:AccessGateMatrix, dis:KnowledgeDocument,
        dis:TagDefinition, dis:PrivacyManifest, dis:TelemetryConfiguration,
        dis:MarketplaceEntry, dis:ChangeManagementRecord, dis:ValueEngineeringProfile,
        dis:DossierComparison .

dis:SystemsView a dis:View ;
    rdfs:label "Systems" ;
    rdfs:comment "Where facts come from — applications, endpoints, the functions that call them, and the triplets they bind." ;
    sh:order 25 ;
    dis:showsConstruct dis:Application, dis:Endpoint, dis:FunctionCatalogEntry, dis:AgenticTriplet .

dis:GrammarView a dis:View ;
    rdfs:label "Grammar" ;
    rdfs:comment "What is sayable at all — every entity's supported modes and every role's gates." ;
    sh:order 15 ;
    dis:showsConstruct dis:Role, dis:Entity, dis:EntityModeMatrix, dis:AccessGateMatrix .


# ---------- the systems layer — WHERE a fact comes from ----------
# These classes were declared in dis.ttl from 1.7 onward but had no shapes, so
# nothing generated from the shapes could see them: the palette had an empty
# Systems group and AgenticTriplet.boundFunction pointed at a class the canvas
# could not place. A class declared only in the vocabulary is invisible, exactly
# as a property referenced only in a conditional is.

dis:ApplicationShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:Application ;
    sh:name "Application" ;
    sh:description "A system that holds facts. The system of record, or the mock standing in for one." ;
    sh:order 10 ;
    sh:group dis:SystemsGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:applicationType ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( dis:SYSTEM_OF_RECORD dis:SAAS_PLATFORM dis:MOCK dis:KNOWLEDGE_STORE ) ;
                  sh:message "applicationType must be one of the four declared kinds" ] ;
    sh:property [ sh:path dis:networkScope ; sh:maxCount 1 ; sh:class dis:NetworkScope ] ;
    sh:property [ sh:path dis:baseUrl ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "baseUrl is required" ] ;
    sh:property [ sh:path dis:authMethod ; sh:maxCount 1 ;
                  sh:in ( dis:NONE dis:API_KEY dis:OAUTH2 dis:BEARER ) ] ;
    sh:sparql [
        sh:message "baseUrl is required and must be https — a target that cannot reach it cannot use it" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this (dis:baseUrl AS ?path) WHERE {
                $this dis:baseUrl ?url .
                OPTIONAL { $this dis:networkScope ?scope }
                FILTER (!BOUND(?scope) || ?scope = dis:SCOPE_PUBLIC)
                FILTER (!STRSTARTS(STR(?url), "https://"))
            }
        """
    ] .

dis:EndpointShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:Endpoint ;
    sh:name "Endpoint" ;
    sh:description "One callable operation on an Application." ;
    sh:order 20 ;
    sh:group dis:SystemsGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:hostedBy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Application ;
                  sh:message "an endpoint must be hosted by an Application" ] ;
    sh:property [ sh:path dis:transport ; sh:maxCount 1 ; sh:class dis:Transport ] ;
    sh:property [ sh:path dis:httpMethod ; sh:maxCount 1 ;
                  sh:in ( dis:GET dis:POST dis:PUT dis:PATCH dis:HTTP_DELETE ) ] ;
    sh:property [ sh:path dis:urlPath ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^/" ;
                  sh:message "urlPath is relative to the Application's baseUrl and must start with /" ] ;
    sh:property [ sh:path dis:topic ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:streamUri ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:subject ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:peerAddress ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:socketPath ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:channel ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:mutates ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
                  sh:message "declare whether this endpoint changes state; HTTP method is not the answer" ] ;
    sh:or (
        [ sh:property [ sh:path dis:transport ; sh:in ( dis:TRANSPORT_MQTT dis:TRANSPORT_RTSP dis:TRANSPORT_ESPNOW dis:TRANSPORT_NATS dis:TRANSPORT_UNIX_SOCKET dis:TRANSPORT_BLE dis:TRANSPORT_SERIAL dis:TRANSPORT_CAN_BUS ) ] ]
        [ sh:and (
            [ sh:property [ sh:path dis:httpMethod ; sh:minCount 1 ] ]
            [ sh:property [ sh:path dis:urlPath ; sh:minCount 1 ] ]
        ) ]
    ) .

dis:FunctionCatalogEntryShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:FunctionCatalogEntry ;
    sh:name "Function" ;
    sh:description "HOW an intent is executed. Binds a triplet to an endpoint and an entity." ;
    sh:order 30 ;
    sh:group dis:SystemsGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:callsEndpoint ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Endpoint ;
                  sh:message "a function must call an Endpoint — otherwise it states nothing executable" ] ;
    sh:property [ sh:path dis:readsEntity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dis:Entity ;
                  sh:message "readsEntity is required and must reference a dis:Entity" ] ;
    sh:property [ sh:path dis:writesEntity ; sh:maxCount 1 ; sh:class dis:Entity ;
                  sh:message "writesEntity must reference a dis:Entity" ] ;
    sh:property [ sh:path dis:inputFields ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "comma-separated field names the caller must supply" ] ;
    sh:property [ sh:path dis:outputFields ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "comma-separated field names the response returns" ] .

# A mock is a design-time stand-in. Saying so is the point of the type, so a
# mock that claims to be the system of record is a contradiction worth catching.
dis:MockHonestyShape a sh:NodeShape ;
    sh:targetClass dis:Application ;
    sh:not [ sh:and (
      [ sh:property [ sh:path dis:applicationType ; sh:hasValue dis:MOCK ] ]
      [ sh:property [ sh:path dis:applicationType ; sh:hasValue dis:SYSTEM_OF_RECORD ] ]
    ) ] ;
    sh:message "an Application cannot be both a MOCK and the SYSTEM_OF_RECORD" .


# ---------- the grammar matrices — what is even sayable ----------
dis:EntityModeMatrixShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:EntityModeMatrix ;
    sh:name "Entity-mode matrix" ;
    sh:description "Which of the seven modes this entity supports at all." ;
    sh:order 30 ;
    sh:group dis:PeopleGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:matrixEntity ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Entity ;
                  sh:message "an entity-mode matrix must name the Entity it bounds" ] ;
    sh:property [ sh:path dis:supportedMode ; sh:minCount 1 ;
                  sh:class dis:Mode ;
                  sh:message "at least one mode — an entity supporting nothing cannot appear in any triplet" ] .

dis:AccessGateMatrixShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:AccessGateMatrix ;
    sh:name "Access gate" ;
    sh:description "Which modes this role may use on this entity. Authority, not utterance." ;
    sh:order 40 ;
    sh:group dis:PeopleGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:matrixRole ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Role ;
                  sh:message "an access gate must name the Role it grants to" ] ;
    sh:property [ sh:path dis:matrixEntity ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class dis:Entity ;
                  sh:message "an access gate must name the Entity it protects" ] ;
    sh:property [ sh:path dis:allowedMode ;
                  sh:class dis:Mode ;
                  sh:message "allowedMode must be one of the seven canonical modes" ] ;
    sh:property [ sh:path dis:allowedFunction ;
                  sh:class dis:FunctionCatalogEntry ;
                  sh:message "allowedFunction must reference a dis:FunctionCatalogEntry" ] ;
    sh:property [ sh:path dis:gateCondition ; sh:maxCount 1 ; sh:datatype xsd:string ] .


# ---------- the grammar is enforced, not documented ----------
# A triplet asserts that a Role uses a Mode on an Entity. That is only legal if
# the Entity supports the mode at all, and the Role has been granted it. Without
# these shapes the matrices are a picture beside the model; with them, an
# illegal triplet cannot be committed.
#
# SPARQL rather than property paths because the constraint spans three subjects:
# the triplet, the entity's mode matrix, and the role's gate.

dis:TripletWithinEntityModeShape a sh:NodeShape ;
    sh:targetClass dis:AgenticTriplet ;
    sh:sparql [
        sh:message "this triplet uses a mode the target entity does not support — declare it in the entity's EntityModeMatrix, or the triplet is not sayable" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this WHERE {
              $this dis:targetEntity ?entity ;
                    dis:mode ?mode .
              FILTER NOT EXISTS {
                ?matrix a dis:EntityModeMatrix ;
                        dis:matrixEntity ?entity ;
                        dis:supportedMode ?mode .
              }
              FILTER EXISTS { ?any a dis:EntityModeMatrix }
            }
        """ ] .

dis:TripletWithinAccessGateShape a sh:NodeShape ;
    sh:targetClass dis:AgenticTriplet ;
    sh:sparql [
        sh:message "this triplet's acting role has no access gate granting that mode on that entity — authority says who may, and nothing here says this role may" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this WHERE {
              $this dis:actingRole ?role ;
                    dis:targetEntity ?entity ;
                    dis:mode ?mode .
              FILTER NOT EXISTS {
                ?gate a dis:AccessGateMatrix ;
                      dis:matrixRole ?role ;
                      dis:matrixEntity ?entity ;
                      dis:allowedMode ?mode .
              }
              FILTER EXISTS { ?any a dis:AccessGateMatrix }
            }
        """ ] .

dis:TripletWithinAllowedFunctionGateShape a sh:NodeShape ;
    sh:targetClass dis:AgenticTriplet ;
    sh:sparql [
        sh:message "this triplet binds a function not permitted by the role's function-scoped access gate" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this (dis:boundFunction AS ?path) WHERE {
              $this dis:actingRole ?role ;
                    dis:targetEntity ?entity ;
                    dis:mode ?mode ;
                    dis:boundFunction ?fn .
              ?gate a dis:AccessGateMatrix ;
                    dis:matrixRole ?role ;
                    dis:matrixEntity ?entity ;
                    dis:allowedMode ?mode ;
                    dis:allowedFunction ?anyFn .
              FILTER NOT EXISTS {
                ?gate dis:allowedFunction ?fn .
              }
            }
        """ ] .

# ---------- provenance and mutation integrity (1.8) ----------
dis:TripletModeMutationConsistencyShape a sh:NodeShape ;
    sh:targetClass dis:AgenticTriplet ;
    sh:sparql [
        sh:message "triplet mode and bound function endpoint mutates mismatch: READ requires mutates false; CREATE/UPDATE/DELETE requires mutates true" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this (dis:boundFunction AS ?path) WHERE {
                $this dis:mode ?mode ;
                      dis:boundFunction ?fn .
                ?fn dis:callsEndpoint ?ep .
                ?ep dis:mutates ?mutates .
                FILTER (
                    (?mode = dis:READ && ?mutates = true) ||
                    (?mode IN (dis:CREATE, dis:UPDATE, dis:DELETE) && ?mutates = false)
                )
            }
        """
    ] .

dis:FunctionMutatesNeedsWritesEntityShape a sh:NodeShape ;
    sh:targetClass dis:FunctionCatalogEntry ;
    sh:sparql [
        sh:message "a function calling a mutating endpoint must declare writesEntity" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this (dis:writesEntity AS ?path) WHERE {
                $this dis:callsEndpoint ?ep .
                ?ep dis:mutates true .
                FILTER NOT EXISTS { $this dis:writesEntity ?entity }
            }
        """
    ] .

dis:TripletTargetEntityConsistencyShape a sh:NodeShape ;
    sh:targetClass dis:AgenticTriplet ;
    sh:sparql [
        sh:message "triplet targetEntity must match the bound function's readsEntity (for READ) or writesEntity (for CREATE/UPDATE/DELETE)" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this (dis:targetEntity AS ?path) WHERE {
                $this dis:mode ?mode ;
                      dis:targetEntity ?target ;
                      dis:boundFunction ?fn .
                OPTIONAL { ?fn dis:readsEntity ?reads }
                OPTIONAL { ?fn dis:writesEntity ?writes }
                FILTER (
                    (?mode = dis:READ && BOUND(?reads) && ?target != ?reads) ||
                    (?mode IN (dis:CREATE, dis:UPDATE, dis:DELETE) && BOUND(?writes) && ?target != ?writes)
                )
            }
        """
    ] .


# ---------- entity instances ----------
dis:EntityInstanceShape a sh:NodeShape ;
    sh:targetClass dis:EntityInstance ;
    sh:property [ sh:path dis:instanceOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dis:Entity ;
                  sh:message "an instance must name the Entity whose population it belongs to" ] ;
    sh:property [ sh:path dis:spokenForm ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "what a person says out loud — without it the recogniser gets no vocabulary" ] ;
    sh:property [ sh:path dis:systemKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "how a system addresses it — the compiler maps to this, the model never emits it" ] ;
    sh:property [ sh:path dis:confusableWith ; sh:class dis:EntityInstance ;
                  sh:message "confusableWith must reference another instance" ] .

# An instance cannot be confusable with itself — that is a modelling slip, and it
# would make a compiler emit a disambiguation turn that can never resolve.
dis:InstanceNotSelfConfusableShape a sh:NodeShape ;
    sh:targetClass dis:EntityInstance ;
    sh:sparql [
        sh:message "an instance is declared confusable with itself — a disambiguation turn built from this can never terminate" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this WHERE { $this dis:confusableWith $this . }
        """ ] .


# ---------- governance and value constructs (ported from 1.6 in 1.7) ----------
# RAV-1947 gap 5: these eight rdfs:subClassOf dis:Construct classes were
# declared in dis.ttl but had no targeting NodeShape — invisible to the
# palette and unvalidated. Constraints below are derived from each
# property's own domain/range declaration in dis.ttl; none are invented.

dis:TagDefinitionShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:TagDefinition ;
    sh:name "Tag definition" ;
    sh:description "A semantic category and its closed set of allowed values." ;
    sh:order 50 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:allowedValue ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:message "at least one allowed value — a category with no members has no closed set" ] ;
    sh:property [ sh:path dis:multiSelect ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

dis:PrivacyManifestShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:PrivacyManifest ;
    sh:name "Privacy manifest" ;
    sh:description "Data privacy, handling, and purpose-of-use policy for one or more Entity attributes." ;
    sh:order 60 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:governsAttribute ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^/" ;
                  sh:message "governsAttribute must be an RFC 6901 JSON pointer, starting with /" ] ;
    sh:property [ sh:path dis:dataCategory ; sh:minCount 1 ; sh:class dis:DataCategory ;
                  sh:message "at least one declared data category" ] ;
    sh:property [ sh:path dis:processingPurpose ; sh:minCount 1 ; sh:class dis:ProcessingPurpose ;
                  sh:message "at least one declared processing purpose" ] ;
    sh:property [ sh:path dis:storagePolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dis:StoragePolicy ;
                  sh:message "exactly one storage policy" ] .

dis:TelemetryConfigurationShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:TelemetryConfiguration ;
    sh:name "Telemetry configuration" ;
    sh:description "Design-time observability spec: what to observe, never how." ;
    sh:order 70 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    # metricType lives on metric nodes the vocabulary does not yet link to the
    # configuration (dis:metricType has no rdfs:domain). Not adding a linking
    # property here — that is a vocabulary decision, not a shapes one.
    sh:property [ sh:path dis:logLevel ; sh:maxCount 1 ; sh:class dis:TelemetryLogLevel ] .

dis:MarketplaceEntryShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:MarketplaceEntry ;
    sh:name "Marketplace entry" ;
    sh:description "Publication metadata for offering a Dossier in a marketplace or exchange." ;
    sh:order 80 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:listsDossier ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "must point at the dossier's own root IRI" ] ;
    sh:property [ sh:path dis:publisherName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:pricingModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dis:MarketplacePricingModel ] ;
    sh:property [ sh:path dis:marketplaceCategory ; sh:minCount 1 ; sh:class dis:MarketplaceCategory ] ;
    sh:property [ sh:path dis:documentationUrl ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^https://" ;
                  sh:message "documentationUrl must be https" ] .

dis:ChangeManagementRecordShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:ChangeManagementRecord ;
    sh:name "Change management record" ;
    sh:description "The approval workflow and audit trail for one change to a Dossier." ;
    sh:order 90 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:recordsChangeTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "must point at the dossier's own root IRI" ] ;
    sh:property [ sh:path dis:fromVersion ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:toVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:changeStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dis:ChangeManagementStatus ] ;
    sh:property [ sh:path dis:submittedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:approver ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# An APPROVED change without a named approver is exactly the undeclared-write
# problem §6.1 names for BE — a version bump with no record of who signed it.
dis:ApprovedChangeNamesApproverShape a sh:NodeShape ;
    sh:targetClass dis:ChangeManagementRecord ;
    sh:or (
      [ sh:not [ sh:property [ sh:path dis:changeStatus ; sh:hasValue dis:APPROVED ] ] ]
      [ sh:property [ sh:path dis:approver ; sh:minCount 1 ] ]
    ) ;
    sh:message "an APPROVED change must name who approved it — a version bump without a signer is the undeclared-write problem" .

dis:ValueEngineeringProfileShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:ValueEngineeringProfile ;
    sh:name "Value engineering profile" ;
    sh:description "Operational metrics and a cost model, as an AS-IS baseline or a TO-BE projection." ;
    sh:order 100 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:currency ; sh:maxCount 1 ; sh:class dis:Currency ] ;
    sh:property [ sh:path dis:avgLaborRatePerHour ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path dis:costFormula ; sh:maxCount 1 ; sh:datatype xsd:string ] .

dis:DossierComparisonShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:DossierComparison ;
    sh:name "Dossier comparison" ;
    sh:description "A delta analysis between a Discovery dossier and a Design dossier." ;
    sh:order 110 ;
    sh:group dis:GovernanceGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape ;
    sh:property [ sh:path dis:comparesDiscovery ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "must point at the Discovery (AS-IS) dossier's own root IRI" ] ;
    sh:property [ sh:path dis:comparesDesign ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "must point at the Design (TO-BE) dossier's own root IRI" ] ;
    sh:property [ sh:path dis:addsEntity ; sh:class dis:Entity ] ;
    sh:property [ sh:path dis:removesEntity ; sh:class dis:Entity ] ;
    sh:property [ sh:path dis:addsTriplet ; sh:class dis:AgenticTriplet ] ;
    sh:property [ sh:path dis:removesTriplet ; sh:class dis:AgenticTriplet ] ;
    sh:property [ sh:path dis:automatesProcess ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dis:baselineProfile ; sh:maxCount 1 ; sh:class dis:ValueEngineeringProfile ] ;
    sh:property [ sh:path dis:projectedProfile ; sh:maxCount 1 ; sh:class dis:ValueEngineeringProfile ] ;
    sh:property [ sh:path dis:projectedAnnualSavings ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path dis:projectedRoiPercentage ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

dis:ComparisonIsBetweenTwoDossiersShape a sh:NodeShape ;
    sh:targetClass dis:DossierComparison ;
    sh:sparql [
        sh:message "a comparison of a dossier with itself has no delta" ;
        sh:prefixes dis: ;
        sh:select """
            SELECT $this WHERE { $this dis:comparesDiscovery ?x ; dis:comparesDesign ?x . }
        """ ] .

dis:KnowledgeDocumentShape a sh:NodeShape ;
    dis:paletteConstruct true ;
    sh:targetClass dis:KnowledgeDocument ;
    sh:name "Knowledge document" ;
    sh:description "A document the agent may draw on. Retrieval scope undecided — see spec §9.3." ;
    # §9.3 of the 1.7 proposal leaves retrieval scope (which documents, how
    # chunked, how ranked) an open question. Name and description only.
    sh:order 40 ;
    sh:group dis:SystemsGroup ;
    sh:property dis:RequiredNameShape ;
    sh:property dis:RequiredDescriptionShape .


# ---------- dossier metadata (1.7) ----------
# RAV-1947 gap 7: early drafts and dadjoke.ttl declared a header using
# dis:Dossier/dis:domainName/dis:disSpecificationRef, none of which dis.ttl
# ever declared. The vocabulary's actual design (see dis.ttl's own comment
# above DossierType) is ontology-style triples on the dossier's own root
# IRI: dis:dossierType, dis:dossierStatus, owl:versionInfo.

# owl:versionInfo is a standard OWL property, not a DIS one, but it is now
# used as an sh:path below — the gap-4 fix (every sh:path is a declared
# property somewhere) covers imported paths too.
<http://www.w3.org/2002/07/owl#versionInfo> a rdf:Property .

dis:DossierMetadataShape a sh:NodeShape ;
    sh:targetSubjectsOf dis:dossierType ;
    sh:property [ sh:path dis:dossierType ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( dis:DISCOVERY dis:DESIGN dis:DEPLOYMENT dis:TEMPLATE ) ;
                  sh:message "dossierType must be exactly one of DISCOVERY, DESIGN, DEPLOYMENT, TEMPLATE" ] ;
    sh:property [ sh:path <http://www.w3.org/2002/07/owl#versionInfo> ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:message "a dossier must declare exactly one owl:versionInfo" ] .

dis:DossierStatusMetadataShape a sh:NodeShape ;
    sh:targetSubjectsOf dis:dossierStatus ;
    sh:property [ sh:path dis:dossierStatus ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( dis:DRAFT dis:IN_REVIEW dis:APPROVED dis:PUBLISHED dis:DEPRECATED ) ;
                  sh:message "dossierStatus must be exactly one of DRAFT, IN_REVIEW, APPROVED, PUBLISHED, DEPRECATED" ] ;
    sh:property [ sh:path <http://www.w3.org/2002/07/owl#versionInfo> ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:message "a dossier must declare exactly one owl:versionInfo" ] .
